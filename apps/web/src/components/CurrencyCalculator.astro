<a class="skip-link" href="#calculator" data-i18n="skipToCalculator">跳到换算器</a>

<div class="world" aria-hidden="true">
  <div class="cloud cloud-one"></div>
  <div class="cloud cloud-two"></div>
  <div class="floating-block block-one"></div>
  <div class="floating-block block-two"></div>
  <div class="ground-line"></div>
</div>

<header class="site-header">
  <a class="brand" href="/" data-i18n-aria-label="brandHome" aria-label="Base Money 首页">
    <span class="brand-cube" aria-hidden="true"><span>¥</span></span>
    <span class="brand-copy">
      <strong>BASE MONEY</strong>
      <small data-i18n="brandTagline">你的本位币换算器</small>
    </span>
  </a>

  <div class="header-actions">
    <div class="language-switcher" id="language-switcher">
      <button
        class="pixel-button language-trigger"
        id="open-language"
        type="button"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-controls="language-menu"
        data-i18n-aria-label="language"
        aria-label="语言"
      >
        <span class="language-flag" id="language-flag" aria-hidden="true">🇨🇳</span>
      </button>
      <div
        class="language-menu"
        id="language-menu"
        hidden
        role="menu"
        data-i18n-aria-label="languageMenu"
        aria-label="选择语言"
      >
        <button type="button" role="menuitemradio" data-locale="zh-CN" lang="zh-CN" aria-checked="true">
          <span aria-hidden="true">🇨🇳</span>
          <span>简体中文</span>
        </button>
        <button type="button" role="menuitemradio" data-locale="zh-HK" lang="zh-HK" aria-checked="false">
          <span aria-hidden="true">🇭🇰</span>
          <span>繁體中文</span>
        </button>
        <button type="button" role="menuitemradio" data-locale="ja" lang="ja" aria-checked="false">
          <span aria-hidden="true">🇯🇵</span>
          <span>日本語</span>
        </button>
        <button type="button" role="menuitemradio" data-locale="en" lang="en" aria-checked="false">
          <span aria-hidden="true">🇺🇸</span>
          <span>English</span>
        </button>
      </div>
    </div>

    <button class="pixel-button settings-trigger" id="open-settings" type="button">
      <span class="gear" aria-hidden="true">⚙</span>
      <span data-i18n="settings">设置</span>
    </button>
  </div>
</header>

<main id="calculator" tabindex="-1">
  <section class="intro" aria-labelledby="page-title">
    <h1 id="page-title" data-i18n="slogan">看心里有数的价格</h1>
  </section>

  <section class="workbench" data-i18n-aria-label="calculatorLabel" aria-label="汇率换算器">
    <div class="bench-top" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="input-panel">
      <div class="panel-heading">
        <div>
          <p class="panel-kicker english-kicker" data-i18n="amountKicker">AMOUNT TO CONVERT</p>
          <h2 data-i18n="amountHeading">现实价格</h2>
        </div>
        <div class="torch" aria-hidden="true"><span></span></div>
      </div>

      <form id="amount-form" action="/" method="get" novalidate>
        <fieldset>
          <legend class="visually-hidden" data-i18n="amountLegend">输入待换算的金额和币种</legend>

          <div class="amount-field">
            <label for="amount" data-i18n="amountLabel">金额</label>
            <p class="field-hint" id="amount-hint" data-i18n="amountHint">可使用小数点或小数逗号，不需要输入货币符号。</p>
            <div class="amount-control">
              <span class="prompt" aria-hidden="true">›</span>
              <div class="amount-field-shell" data-replicated-value="100">
                <textarea
                  id="amount"
                  name="amount"
                  rows="1"
                  inputmode="decimal"
                  enterkeyhint="done"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                  wrap="soft"
                  aria-describedby="amount-hint amount-error"
                >100</textarea>
              </div>
              <button
                class="clear-button"
                id="clear-amount"
                type="button"
                data-i18n="clearAmount"
                data-i18n-aria-label="clearAmountAria"
                aria-label="清空金额"
              >清空</button>
            </div>
            <p class="field-error" id="amount-error" aria-live="polite"></p>
          </div>

          <div class="currency-field">
            <label for="input-currency">
              <span class="wide-label" data-i18n="inputCurrencyWide">这次使用的币种</span>
              <span class="mobile-label" data-i18n="inputCurrencyMobile">输入币种</span>
            </label>
            <div class="select-shell">
              <select id="input-currency" name="currency">
                <option value="USD">USD — 美元</option>
              </select>
            </div>
          </div>
        </fieldset>
      </form>

      <div class="error-panel" id="rates-error" hidden>
        <span aria-hidden="true">!</span>
        <p data-i18n="ratesError">暂时无法获取汇率。金额会保留，你可以稍后重试。</p>
        <button class="pixel-button compact" id="retry-rates" type="button" data-i18n="retrySync">重新同步</button>
      </div>
    </div>

    <div class="result-panel">
      <div class="panel-heading result-heading">
        <div>
          <p class="panel-kicker english-kicker" data-i18n="resultsKicker">YOUR BASE CURRENCIES</p>
          <h2 data-i18n="resultsHeading">本位价格</h2>
        </div>
        <span class="mini-map" aria-hidden="true"><i></i></span>
      </div>

      <ul class="result-list" id="result-list" role="list">
        <li class="result-card is-loading">
          <span class="result-code">CNY</span>
          <strong class="result-value">—</strong>
          <small data-i18n="waitingRates">等待汇率同步</small>
        </li>
      </ul>

      <button
        class="add-target"
        id="add-target"
        type="button"
        hidden
        data-i18n-aria-label="addCurrencyAria"
        aria-label="添加本位币"
      >
        <span aria-hidden="true">+</span>
        <span data-i18n="addCurrency">添加</span>
      </button>
    </div>
  </section>

  <p class="source-note">
    <span class="signal" id="sync-signal" aria-hidden="true"></span>
    <span>
      <span data-i18n="sourceNoteBefore">汇率由 </span>
      <a href="https://www.exchangerate-api.com" target="_blank" rel="noreferrer">ExchangeRate-API</a>
      <span id="source-note-status"> 提供 · 正在同步…</span>
    </span>
  </p>
  <p id="sync-status" class="visually-hidden" aria-live="polite">正在同步汇率…</p>
</main>

<dialog class="add-currency-dialog" id="add-currency-dialog" aria-labelledby="add-currency-title" closedby="any">
  <div class="dialog-edge" aria-hidden="true"></div>
  <div class="dialog-header">
    <div>
      <h2 id="add-currency-title" data-i18n="addCurrencyTitle">添加本位币</h2>
    </div>
    <button
      class="icon-button"
      id="close-add-currency"
      type="button"
      data-i18n-aria-label="closeAddCurrency"
      aria-label="关闭"
    >×</button>
  </div>
  <div class="add-currency-body">
    <label for="add-currency-search" data-i18n="searchCurrencies">搜索币种</label>
    <input
      id="add-currency-search"
      type="search"
      data-i18n-placeholder="searchPlaceholder"
      placeholder="例如 JPY 或 日元"
      autocomplete="off"
    />
    <div class="add-currency-list" id="add-currency-list"></div>
  </div>
</dialog>

<dialog class="settings-dialog" id="settings-dialog" aria-labelledby="settings-title">
  <div class="dialog-edge" aria-hidden="true"></div>
  <div class="dialog-header">
    <div>
      <p class="panel-kicker english-kicker" data-i18n="settingsKicker">CURRENCY PREFERENCES</p>
      <h2 id="settings-title" data-i18n="settingsTitle">默认币种设置</h2>
    </div>
    <button
      class="icon-button"
      id="close-settings"
      type="button"
      data-i18n-aria-label="closeSettings"
      aria-label="关闭设置"
    >×</button>
  </div>

  <form id="settings-form">
    <div class="settings-scroll">
      <div class="settings-section">
        <label for="default-input-currency" data-i18n="defaultInput">默认输入币种</label>
        <div class="select-shell">
          <select id="default-input-currency" name="defaultInputCurrency">
            <option value="USD">USD — 美元</option>
          </select>
        </div>
      </div>

      <fieldset class="settings-section target-fieldset">
        <legend data-i18n="homeCurrencies">本位币</legend>
        <div class="target-tools">
          <div>
            <label for="currency-search" data-i18n="searchCurrencies">搜索币种</label>
            <input
              id="currency-search"
              type="search"
              data-i18n-placeholder="searchPlaceholder"
              placeholder="例如 JPY 或 日元"
              autocomplete="off"
            />
          </div>
          <output id="selection-count" for="target-currency-list">0 / 5</output>
        </div>
        <p class="field-hint" id="target-hint" data-i18n="targetHint">最多选择 5 个；一个都不选时仍会显示 CNY。</p>
        <div
          class="currency-choice-list"
          id="target-currency-list"
          aria-describedby="target-hint target-limit-message"
        ></div>
        <p class="limit-message" id="target-limit-message" aria-live="polite"></p>
      </fieldset>
    </div>

    <div class="dialog-actions">
      <button class="text-button" id="reset-settings" type="button" data-i18n="reset">恢复默认</button>
      <div>
        <button class="pixel-button muted" id="cancel-settings" type="button" data-i18n="cancel">取消</button>
        <button class="pixel-button save" id="save-settings" type="submit" data-i18n="saveSettings">保存设置</button>
      </div>
    </div>
  </form>
</dialog>

<dialog class="locale-prompt" id="locale-prompt" aria-labelledby="locale-prompt-title" closedby="any">
  <div class="dialog-edge" aria-hidden="true"></div>
  <div class="locale-prompt-body">
    <p class="locale-prompt-flag" id="locale-prompt-flag" aria-hidden="true">🇺🇸</p>
    <h2 id="locale-prompt-title">Use English?</h2>
    <p id="locale-prompt-copy">Your device language looks like English. Switch this converter to English?</p>
    <div class="locale-prompt-actions">
      <button class="pixel-button muted" id="locale-prompt-keep" type="button">Keep 简体中文</button>
      <button class="pixel-button save" id="locale-prompt-switch" type="button">Use English</button>
    </div>
  </div>
</dialog>

<script>
  import "../scripts/calculator";
</script>
